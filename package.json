{
  "name": "quiztown-dev-client",
  "version": "1.35.2",
  "description": "Quiz Town development Windows client",
  "main": "app/main.js",
  "author": "Quiz Town",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "kr.quiztown.client",
    "productName": "QuizTown",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "game/**/*",
      "package.json",
      "update-config.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "QuizTown-Dev-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "displayLanguageSelector": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QuizTown DEV",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "92129mingyum-tech",
        "repo": "quiztown-dev",
        "releaseType": "release"
      }
    ]
  }
}

