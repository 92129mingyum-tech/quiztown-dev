{
  "name": "q-time-client",
  "version": "1.0.0",
  "description": "Q-TIME Windows client",
  "main": "app/main.js",
  "author": "Q-TIME",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "kr.qtime.client",
    "productName": "Q-TIME",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "game/**/*",
      "package.json",
      "update-config.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Q-TIME-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "displayLanguageSelector": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Q-TIME",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "92129mingyum-tech",
        "repo": "quiztown-dev",
        "releaseType": "release"
      }
    ]
  }
}
